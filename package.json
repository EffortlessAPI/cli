{
  "name": "@effortlessapi/cli",
  "version": "2026.921.2357",
  "description": "REST-only command-line client for EffortlessAPI transpilers",
  "bin": {
    "ssotme": "cli.js",
    "aicapture": "cli.js",
    "effortless": "cli.js",
    "aic": "cli.js"
  },
  "files": [
    "cli.js",
    "lib/"
  ],
  "scripts": {
    "build": "dotnet build Effortless.Cli.sln --configuration Release",
    "test": "dotnet test Effortless.Cli.sln --configuration Release",
    "test:package": "node scripts/test-npm-package.mjs",
    "generate": "node scripts/generate-from-rulebook.mjs",
    "validate:rulebook": "node scripts/validate-rulebook.mjs",
    "build:docs": "effortless build",
    "start": "node cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EffortlessAPI/cli.git"
  },
  "homepage": "https://github.com/EffortlessAPI/cli#readme",
  "bugs": {
    "url": "https://github.com/EffortlessAPI/cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "effortless",
    "ssot",
    "code-generation",
    "transpiler"
  ],
  "author": "EffortlessAPI",
  "license": "MIT",
  "optionalDependencies": {
    "@effortlessapi/cli-darwin-arm64": "2026.913.1830",
    "@effortlessapi/cli-darwin-x64": "2026.913.1830",
    "@effortlessapi/cli-linux-arm64": "2026.913.1830",
    "@effortlessapi/cli-linux-x64": "2026.913.1830",
    "@effortlessapi/cli-win32-arm64": "2026.913.1830",
    "@effortlessapi/cli-win32-x64": "2026.913.1830"
  }
}
